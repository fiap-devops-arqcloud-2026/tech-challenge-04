{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GithubOidcMain",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::SUBSTITUA_ID_AWS:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:fiap-devops-arqcloud-2026@287716251/tech-challenge-04@1373159817:ref:refs/heads/main"
        }
      }
    }
  ]
}

