# ---------------------------------------------------------------
# Terraform - NUNCA versionar estado: contem senhas em texto puro
# ---------------------------------------------------------------
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
# .terraform.lock.hcl NAO entra aqui: o lock DEVE ser versionado para que
# todo o grupo use a mesma versao de provider. Recomendacao da HashiCorp.
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!example.tfvars
!terraform.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan
*.tfplan

# ---------------------------------------------------------------
# Credenciais e segredos
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
!**/key.go
*.p12
*.pfx
credentials
.aws/
kubeconfig
kubeconfig.*
*.kubeconfig

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------
# Go
# ---------------------------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# ---------------------------------------------------------------
# Kubernetes / Kustomize / Helm
# ---------------------------------------------------------------
charts/*.tgz
*.orig

# ---------------------------------------------------------------
# Sistema operacional e editores
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
# Travas temporarias do Microsoft Office (ex.: ~$Apresentacao.pptx). Contem
# o nome do usuario e nao servem para nada fora da maquina de quem abriu.
~$*
# Saida de geradores locais (ex.: PDFs de rascunho). Nao e fonte do projeto.
output/

# Pasta de rascunho de execucao. Apareceu em 2026-09-11 com um script de
# captura de tela dentro; o script foi promovido para scripts/ e a pasta
# passa a ser ignorada, para nao virar deposito de arquivo solto.
tmp/


